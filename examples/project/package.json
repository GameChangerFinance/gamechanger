{
  "version": "0.0.1",
  "name": "build-dummy-gcscript-project",
  "scripts": {
    "link:res": "node -e \"const fs=require('fs');try{fs.rmSync('res',{force:true,recursive:true})}catch{}fs.symlinkSync('../res','res','dir')\"",
    "build": "pnpm run link:res && node ../../bin/cli.js build -f ./main.gcscript.jsonc -o ./dist/built.gcscript.json --noValidate",
    "validate": "node ../../bin/cli.js validate -f ./dist/built.gcscript.json -o ./dist/validation-report.json",
    "serve": "node ../../bin/cli.js mainnet snippet html -v 2 -S -o ./dist/index.html -f ./dist/built.gcscript.json",
    "dev": "pnpm --dir ../.. exec nodemon --watch examples/project --ext gcscript,json,jsonc,hl --ignore examples/project/dist --exec \"pnpm --dir examples/project run build && pnpm --dir examples/project run validate && pnpm --dir examples/project run serve\""
  },
  "devDependencies": {
    "@gamechanger-finance/gc": "file:../..",
    "nodemon": "^3.1.10"
  }
}
