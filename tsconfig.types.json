{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "sourceMap": false,
    "checkJs": false
  },
  "include": ["src"],
  "exclude": ["src/modules/**/*.cjs"]
}
